TS_AUTHKEY=
TS_TAILNET=
# Tailscale machine name (optional; defaults to llama-server).
TS_HOSTNAME=llama-server
# llama.cpp Hugging Face repo to serve: <org>/<repo>[:quant]  (NO "hf.co/" prefix).
# Leave blank to start without a model. Example: ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
MODEL_NAME=
# Only required for gated/private HF repos.
HF_TOKEN=

# --- NVIDIA GPU (e.g. Windows + Docker Desktop/WSL2). Leave all unset for CPU-only. ---
# Merge the GPU override. Path separator is ';' on Windows, ':' on Unix.
# If you want to keep ':' on Windows, also set COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yaml;docker-compose.gpu.yaml
# CUDA image tag (CPU default: server).
LLAMA_IMAGE_TAG=server-cuda
# Layers to offload to GPU; 99 = all, 0 = CPU.
LLAMA_N_GPU_LAYERS=99
