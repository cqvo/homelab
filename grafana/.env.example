# Tailscale auth key for the grafana node. Generate in the admin console:
#   https://login.tailscale.com/admin/settings/keys  (reusable or ephemeral)
# Keep the real .env untracked (it is gitignored).
TS_AUTHKEY=

# Your tailnet domain, used only to build Grafana's root URL.
# Find it in the admin console (e.g. tailnet-abcd.ts.net).
TS_TAILNET=
