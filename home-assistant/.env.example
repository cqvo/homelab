# Tailscale auth key for the home-assistant node. Generate in the admin console:
#   https://login.tailscale.com/admin/settings/keys  (reusable or ephemeral)
# Keep the real .env untracked (it is gitignored).
TS_AUTHKEY=

# Timezone for the Home Assistant container (e.g. America/Los_Angeles).
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Los_Angeles
